{
  "manifest_version": 3,
  "name": "MemoFam MapleScouter Reader",
  "version": "1.0.0",
  "description": "Reads MapleScouter result data for the MemoFam tab that opened it.",
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.app.github.dev/*",
        "https://*.vercel.app/*"
      ],
      "js": ["app-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://maplescouter.com/ko/result*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
